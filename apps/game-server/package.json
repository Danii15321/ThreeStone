{
  "name": "@three-stone/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run src --passWithNoTests",
    "test:load": "vitest run load --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "0.17.45",
    "@colyseus/schema": "4.0.30",
    "@colyseus/ws-transport": "0.17.13",
    "@three-stone/database": "workspace:*",
    "@three-stone/game-core": "workspace:*",
    "@three-stone/protocol": "workspace:*",
    "express": "5.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.17.43",
    "@colyseus/testing": "0.17.11",
    "@colyseus/tools": "0.17.19",
    "@types/express": "5.0.6",
    "tsx": "^4.20.6"
  }
}
