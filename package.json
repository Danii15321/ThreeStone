{
  "name": "three-stone-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "audit:security": "pnpm audit --prod --audit-level high",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @three-stone/database db:generate",
    "db:migrate": "pnpm --filter @three-stone/database db:migrate",
    "dev": "pnpm --filter './packages/**' build && pnpm --parallel --filter @three-stone/web --filter @three-stone/api run dev",
    "dev:game-server": "pnpm --filter './packages/**' build && pnpm --filter @three-stone/game-server dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --recursive --if-present run test",
    "test:e2e": "pnpm --filter @three-stone/web test:e2e",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:load:multiplayer": "pnpm --filter @three-stone/game-server test:load",
    "test:multiplayer": "pnpm --filter @three-stone/game-server test",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "validate:v2": "pnpm check && pnpm audit:security && pnpm test:integration && pnpm test:load:multiplayer && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  }
}
