POSTGRES_DB=three_stone_game
POSTGRES_USER=three_stone_game
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://three_stone_game:local-development-only@localhost:5432/three_stone_game
DATABASE_MAX_CONNECTIONS=10
TEST_DATABASE_URL=postgres://three_stone_game:local-development-only@localhost:5432/three_stone_game

API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=32768

# Générez une valeur aléatoire d’au moins 32 caractères pour chaque environnement.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
