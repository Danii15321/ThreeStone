POSTGRES_DB=three_stone_game
POSTGRES_USER=three_stone_game
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgres://three_stone_game:local-development-only@localhost:5432/three_stone_game
DATABASE_MAX_CONNECTIONS=10
TEST_DATABASE_URL=postgres://three_stone_game:local-development-only@localhost:5432/three_stone_game

API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=32768

# Générez une valeur aléatoire d’au moins 32 caractères pour chaque environnement.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001

# Multijoueur v2. Utilisez des valeurs distinctes et aléatoires par environnement.
GAME_SERVER_HOST=0.0.0.0
# Render fournit PORT ; GAME_SERVER_PORT reste la valeur locale de repli.
GAME_SERVER_PORT=2567
GAME_SERVER_INSTANCE_ID=game-server-local
GAME_SERVER_INTERNAL_URL=http://127.0.0.1:2567
GAME_SERVER_PUBLIC_URL=ws://127.0.0.1:2567
VITE_GAME_SERVER_URL=ws://127.0.0.1:2567
MULTIPLAYER_RATE_LIMIT_MAX=30
MULTIPLAYER_RATE_LIMIT_WINDOW_SECONDS=60
WAITING_ROOM_LIFETIME_SECONDS=900
MULTIPLAYER_TICKET_SECRET=replace-with-a-distinct-32-character-secret
GAME_SERVER_INTERNAL_SECRET=replace-with-another-distinct-32-char-secret

# En production : WEB_ORIGIN, BETTER_AUTH_URL et GAME_SERVER_INTERNAL_URL
# utilisent HTTPS ; GAME_SERVER_PUBLIC_URL et VITE_GAME_SERVER_URL utilisent WSS.
